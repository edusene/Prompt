# === Datafy API (Meta Cloud Proxy) ===
DATAFY_TOKEN=sk_live_xxx
DATAFY_PHONE_NUMBER_ID=cole_o_phone_number_id_aqui
DATAFY_WABA_ID=cole_o_waba_id_aqui
DATAFY_WEBHOOK_SECRET=whsec_xxx

# === Servidor ===
WEBHOOK_URL=https://SEU-NGROK.ngrok-free.app/webhook

# === OpenAI ===
OPENAI_API_KEY=cole_a_api_key_da_openai_aqui
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# 0.0 = segue o script; acima disso ela comeca a improvisar
OPENAI_TEMPERATURE=0.0

# === Buffer / Historico ===
BUFFER_SECONDS=3
MAX_HISTORY=40

# === Prompt do agente ===
SYSTEM_PROMPT=Voce e um assistente util que responde no WhatsApp. Seja breve, natural, use quebras de paragrafo (\n\n) quando fizer sentido dividir ideias.

# === Servidor Flask ===
PORT=5000

# === Banco de dados (Supabase) ===
DB_DRIVER=postgresql
DATABASE_URL=postgresql://postgres.SUA_PROJECT_REF:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# === Painel ===
ADMIN_USER=admin
# Obrigatorias. Vazias (ou com o exemplo antigo) o painel nao deixa ninguem
# entrar. SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_PASSWORD=
SECRET_KEY=

# === Cardapio Digital BALBS ===
BALBS_AGENTE_API_KEY=cole_a_api_key_aqui
